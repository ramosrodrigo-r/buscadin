[Unit]
Description=Buscadin carousel copy worker (Hermes)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=%h/.config/buscadin-carousel/worker.env
ExecStart=/usr/bin/python3 %h/.local/share/buscadin-carousel/carousel_worker.py
Restart=always
RestartSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=tmpfs
BindReadOnlyPaths=%h/.local/share/buscadin-carousel
# All inference runs in a separate non-root container with an immutable runtime.
# The worker itself has no access to the user's Hermes profile or SSH directory.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
MemoryMax=1G
TasksMax=32

[Install]
WantedBy=default.target
