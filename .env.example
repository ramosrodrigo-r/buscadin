TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_ADMIN_USER_ID=
DATABASE_URL=sqlite+aiosqlite:///./data/buscadin.db
COLLECT_INTERVAL_HOURS=12
MAX_NOTIFICATIONS_PER_RUN=20
LOG_LEVEL=INFO
HTTP_TIMEOUT_SECONDS=20
HTTP_MAX_RETRIES=3
HIMALAYAS_API_URL=https://himalayas.app/jobs/api
HIMALAYAS_API_KEY=
# Optional private platform API. Leave both empty until backend is available.
# HTTP is accepted only for loopback; use HTTPS for any other host.
SITE_API_URL=
SITE_API_TOKEN=
# Portal process settings. SITE_API_TOKEN is also the bearer token used by the bot.
SITE_BASE_URL=https://buscadin.app
SITE_CONTACT_EMAIL=contato@buscadin.app
SITE_OFFICIAL_DOMAINS=
PORTAL_HOST=127.0.0.1
PORTAL_PORT=8080
